# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# NEVER put secret values in frontend code.

# --- Stripe API keys ---
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# --- Stripe webhook signing secret ---
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# --- Stripe Price ID: WohnStart Komplett ---
STRIPE_PRICE_KOMPLETT=your_stripe_price_id_here

# --- Legacy Stripe Price IDs ---
STRIPE_PRICE_STANDARD=price_...
STRIPE_PRICE_PLUS=price_...
STRIPE_PRICE_PREMIUM=price_...

# --- KI-Dokumenten-Check ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional
# ANTHROPIC_MODEL=claude-sonnet-5-5
# AI_CHECK_DAILY_LIMIT=20
# AI_CHECK_MAX_PARALLEL=4

# --- Site config ---
BASE_URL=http://localhost:3000

PORT=3000

# --- Security ---
# Set to 1 in production when running behind Render/proxy.
# TRUST_PROXY=1

# HTTPS-only cookies in production.
# FORCE_SECURE_COOKIES=true

# Content Security Policy options.
# CSP_REPORT_ONLY=true
# DISABLE_CSP=true

# Production setting.
# NODE_ENV=production

# --- SEO ---
# BASE_URL is also used for canonical URLs, sitemap.xml and Open Graph.
# Set BASE_URL to https://wohnstart.de in production.

# Optional:
# OG_IMAGE_PATH=/og-image.png